# ===========================================
# 视频转文本工具 - 环境配置示例
# ===========================================
# 请复制此文件为 .env 并填写你的配置
# cp .env_list .env

# ========== 服务端口 ==========
PORT=3002

# ========== Whisper 语音识别配置 ==========
# Whisper 模型大小: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base
# Whisper 模型本地路径（为空则自动下载到默认位置）
WHISPER_MODEL_PATH=None
# 语音识别语言（zh 为中文）
WHISPER_LANGUAGE=zh

# ========== FFmpeg 配置 ==========
# FFmpeg 可执行文件路径（包含 ffmpeg.exe 的目录）
FFMPEG_PATH=D:\ffmpeg\ffmpeg\ffmpeg\bin

# ========== 火山引擎 AI 配置（默认） ==========
# 火山引擎 API Key
VOLCANO_API_KEY=your_volcano_api_key_here
# 火山引擎 API Base URL
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ========== 默认 AI 模型配置 ==========
# 默认使用的 AI 模型名称
AI_MODEL=Doubao-Seed-2.0-lite

# AI 模型映射（JSON 格式）
# 格式说明: "显示名称": {"model": "实际模型ID"}
# 使用单行 JSON 格式（暂不支持多行格式化）
MODEL_MAPPING={"Doubao-Seed-2.0-lite":{"model":"doubao-seed-2-0-lite-260215"}}

# ===========================================
# AI 模型添加示例
# ===========================================
# 如果你想添加新的模型，只需修改 MODEL_MAPPING：
#
# 示例1 - 添加 deepseek-r1:
# MODEL_MAPPING={"deepseek-r1":{"model":"deepseek-r1-250528"},"Doubao-Seed-2.0-lite":{"model":"doubao-seed-2-0-lite-260215"}}
#
# 示例2 - 添加智谱 GLM-4（需要配合前端自定义配置使用）:
# MODEL_MAPPING={"glm-4":{"model":"glm-4"}}
#
# 注意：.env 文件中的模型配置是默认配置
# 用户也可以在前端界面直接填写自己的 API Key 来使用其他模型
